DATABASE_URL=sqlite:///./network_monitor.db
MONITOR_MODE=mock
# Default 60; minimum 5 in mock, 60 in ICMP. Always starts paused.
MONITOR_INTERVAL_SECONDS=60
ALARM_THRESHOLD=3
# Enable only with the separate demo database; no real packets.
MOCK_DEMO=false
PING_TIMEOUT_SECONDS=2
ALLOWED_TARGET_CIDRS=127.0.0.1/32,::1/128
MAX_CONCURRENT_CHECKS=5
APP_BASE_URL=http://127.0.0.1:8000
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=30
LOGIN_SESSION_MINUTES=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=300
SESSION_COOKIE_NAME=avit_session
CSRF_COOKIE_NAME=avit_csrf

# CSV report row cap (1..50000); reports never trigger probes.
CSV_MAX_ROWS=50000

# Notifications default OFF. off/mock records are never promoted to real SMTP.
# Mock measurements always remain network-free, even when SMTP is configured.
NOTIFICATION_MODE=off
NOTIFICATION_CONCURRENCY=2
NOTIFICATION_POLL_SECONDS=2
# Whole send deadline, including connect, TLS, authentication and DATA acceptance.
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=30
# Configure only for a separately authorized SMTP acceptance exercise.
# TLS is mandatory: starttls or implicit; certificate verification stays enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# One configured recipient group; comma separated plain ASCII email addresses (max 20).
SMTP_TO=
